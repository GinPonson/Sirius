{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "player-controls",
  "description": "Allows the video controls webview to subscribe to app events.",
  "webviews": ["video-controls"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to"
  ]
}
